{
  "name": "fipe-data-pipeline",
  "version": "1.14.1",
  "description": "Data pipeline for FIPE vehicle pricing data",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "crawl": "bun src/index.ts crawl",
    "refresh": "bun src/index.ts refresh",
    "status": "bun src/index.ts status",
    "classify": "bun src/index.ts classify",
    "backup": "bun src/index.ts backup",
    "restore-drill": "bun src/index.ts restore-drill",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "check": "vp check && bun run test",
    "test": "vp test run src && bun run test:integration",
    "test:integration": "bun scripts/test-integration.ts",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "vp check --no-fmt --no-lint",
    "prepare": "test ! -x node_modules/.bin/vp || vp config --no-agent"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "commander": "^14.0.2",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.10.2",
    "drizzle-kit": "^0.31.8",
    "semantic-release": "^25.0.2",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7",
    "vite-plus": "0.2.7"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.7"
  },
  "packageManager": "bun@1.3.14"
}
