# Host connection for the local PostgreSQL service.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/fipe

# FIPE requests: positive delays, maximum >= minimum, integer retries from 0 to 10.
RATE_LIMIT_MS=800
MAX_THROTTLE_MS=5000
MAX_RETRIES=3
FIPE_PROXY=

# Optional. Required only for classify or crawl --classify.
ANTHROPIC_API_KEY=

# Optional consumer integration. The consuming application owns latest_prices.
# Enable only after that materialized view and its unique index are provisioned.
REFRESH_LATEST_PRICES=false

# Optional S3-compatible backup target, required only for backup / restore-drill.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
